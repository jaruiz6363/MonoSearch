<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MonoSearch</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- OSLO, Optalix, Optiland and LHLT writers, on AberrationCalculator's lens model. AberrationCalculatorDir
         comes from AberrationCalculator.Location.props at the repository root: the subtree in external/. -->
    <ProjectReference Include="$(AberrationCalculatorDir)src/AberrationCalculator.IO/AberrationCalculator.IO.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vendor glass catalogs, copied next to every program that references this library. -->
    <None Include="..\..\catalogs\*.AGF" Link="catalogs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
