<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MonoSearch.App.ViewModels"
        xmlns:views="using:MonoSearch.App.Views"
        x:Class="MonoSearch.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="False"
        Title="{Binding Title}"
        Icon="/Assets/icon.ico"
        Width="1380" Height="880"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGesture="Ctrl+N" Click="NewClick"/>
                <MenuItem Header="_Open..." InputGesture="Ctrl+O" Click="OpenClick"/>
                <MenuItem Header="_Save" InputGesture="Ctrl+S" Click="SaveClick"/>
                <MenuItem Header="Save _As..." InputGesture="Ctrl+Shift+S" Click="SaveAsClick"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="ExitClick"/>
            </MenuItem>
            <MenuItem Header="_Search">
                <MenuItem Header="_Run" InputGesture="F5" Command="{Binding RunCommand}"/>
                <MenuItem Header="_Stop (keep results so far)" Command="{Binding CancelCommand}"/>
                <Separator/>
                <MenuItem Header="_Export Top N" Click="ExportTopClick" IsEnabled="{Binding CanExport}"/>
                <MenuItem Header="Export _Selected" Click="ExportSelectedClick" IsEnabled="{Binding CanExport}"/>
                <MenuItem Header="Save _Table as CSV..." Click="SaveTableClick" IsEnabled="{Binding CanExport}"/>
                <MenuItem Header="_Open Output Folder" Click="OpenFolderClick"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="AboutClick"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="8,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <ProgressBar Grid.Column="1" Width="240" Minimum="0" Maximum="100" Value="{Binding Progress}" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="400,*">

            <!-- Settings -->
            <ScrollViewer Grid.Column="0" Background="#FAFAFA">
                <StackPanel Margin="12,4,12,12">

                    <TextBlock Classes="group" Text="Lens"/>
                    <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto">
                        <TextBlock Classes="label" Text="Focal length (mm)"/>
                        <TextBox Grid.Column="1" Text="{Binding FocalLength}"/>
                        <TextBlock Classes="label" Grid.Row="1" Text="F-number"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FNumber}"/>
                        <TextBlock Classes="label" Grid.Row="2" Text="Min back focus (mm)"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MinBackFocus}"
                                 ToolTip.Tip="Clearance from the rear shell vertex to the image. 0 = any image outside the lens."/>
                        <TextBlock Classes="label" Grid.Row="3" Text="Half field of view (deg)"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding HalfFieldAngle}"
                                 ToolTip.Tip="Fields of the exported files (0, half, full) and of the drawing. A monocentric lens is the same about every chief ray, so this does not change the ranking."/>
                    </Grid>

                    <TextBlock Classes="group" Text="Wavelengths (um) and weights"/>
                    <DataGrid ItemsSource="{Binding Wavelengths}" SelectedItem="{Binding SelectedWavelength}"
                              AutoGenerateColumns="False" Height="170" CanUserSortColumns="False"
                              GridLinesVisibility="All" BorderThickness="1" BorderBrush="#CCCCCC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Wavelength (um)" Binding="{Binding Micrometres}" Width="*"/>
                            <DataGridTextColumn Header="Weight" Binding="{Binding Weight}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                        <Button Content="Add" Command="{Binding AddWavelengthCommand}"/>
                        <Button Content="Remove" Command="{Binding RemoveWavelengthCommand}"/>
                        <Button Content="Sort" Command="{Binding SortWavelengthsCommand}"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto" Margin="0,6,0,0">
                        <TextBlock Classes="label" Text="Primary (row number)"/>
                        <TextBox Grid.Column="1" Text="{Binding PrimaryWavelength}"/>
                        <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Content="Automatic design wavelength"
                                  IsChecked="{Binding AutoDesignWavelength}"
                                  ToolTip.Tip="Sets the focal length (Eq. 9) and Q. Automatic: the d line when it lies inside the band, else the primary."/>
                        <TextBlock Classes="label" Grid.Row="2" Text="Design wavelength (um)"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DesignWavelength}"
                                 IsEnabled="{Binding !AutoDesignWavelength}"/>
                    </Grid>

                    <TextBlock Classes="group" Text="Glass catalogs"/>
                    <ItemsControl ItemsSource="{Binding Catalogs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Description}" IsChecked="{Binding IsSelected}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox Content="Include obsolete glasses" IsChecked="{Binding IncludeObsolete}"/>
                    <Grid ColumnDefinitions="170,*" Margin="0,4,0,0">
                        <CheckBox Content="Max CTE difference" IsChecked="{Binding LimitCte}"
                                  ToolTip.Tip="Largest thermal-expansion difference (1e-6/K) between the cemented shell and ball. Stamenov et al. 2013 cite below 1.5 for cemented surfaces in outdoor optics. Glasses whose catalog gives no CTE are left out."/>
                        <TextBox Grid.Column="1" Text="{Binding MaxCteDifference}" IsEnabled="{Binding LimitCte}"/>
                    </Grid>

                    <TextBlock Classes="group" Text="Architecture"/>
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:MainViewModel.ArchitectureNames}"
                              SelectedIndex="{Binding ArchitectureIndex}"/>
                    <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0" IsVisible="{Binding Is4GA8}">
                        <TextBlock Classes="label" Text="Core glasses"/>
                        <TextBox Grid.Column="1" Text="{Binding CoreGlassesText}" Watermark="from a 2GS search"
                                 ToolTip.Tip="Ball glasses as CATALOG:NAME, comma separated (e.g. SUMITA:K-GFK68). Empty: the best ball glasses of a 2GS search with these settings, as the paper seeds its search. Or select 2GS results and press Use cores for 4GA-8."/>
                        <TextBlock Classes="label" Grid.Row="1" Text="Cores from 2GS (if empty)"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CoreCount}"/>
                        <TextBlock Classes="label" Grid.Row="2" Text="Glass grouping"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Static vm:MainViewModel.GroupingNames}" SelectedIndex="{Binding GroupingIndex}"
                                  ToolTip.Tip="Near-identical glasses (nd, Vd and PgF within 0.005/0.5/0.002 fine, 0.01/1/0.003 normal, 0.02/1.5/0.005 coarse) are searched as one; the others of a group are tried on the best designs afterwards. With 9 wavelengths one core takes about 4 min coarse, 15 min normal, an hour fine on 16 threads; fewer wavelengths are faster."/>
                    </Grid>
                    <TextBlock IsVisible="{Binding Is4GA8}" TextWrapping="Wrap" FontSize="11" Foreground="#666666" Margin="0,4,0,0"
                               Text="With a CTE limit, the front and rear shells must match the core (both are cemented to it); the meniscus is air-spaced."/>

                    <TextBlock Classes="group" Text="Search"/>
                    <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto">
                        <TextBlock Classes="label" Text="r1 from"/>
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Static vm:MainViewModel.ModeNames}" SelectedIndex="{Binding ModeIndex}"/>
                        <TextBlock Classes="label" Grid.Row="1" Text="Refocus"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Static vm:MainViewModel.FocusNames}" SelectedIndex="{Binding FocusIndex}"/>
                        <TextBlock Classes="label" Grid.Row="2" Text="r1 scan points"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ScanPoints}"/>
                        <TextBlock Classes="label" Grid.Row="3" Text="Keep top"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding KeepTop}"/>
                    </Grid>

                    <TextBlock Classes="group" Text="Export"/>
                    <Grid ColumnDefinitions="170,*" RowDefinitions="Auto">
                        <TextBlock Classes="label" Text="Export top N"/>
                        <TextBox Grid.Column="1" Text="{Binding ExportCount}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Formats}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Description}" IsChecked="{Binding IsSelected}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="label" Text="Output folder" Margin="0,6,0,2"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding OutputFolder}"
                                 ToolTip.Tip="A relative folder is taken from the settings file's folder, or Documents\MonoSearch before it is saved."/>
                        <Button Grid.Column="1" Content="..." Margin="4,0,0,0" Click="BrowseOutputClick"/>
                    </Grid>
                    <CheckBox Content="Install Optiland glasses into ~/.optiland/catalogs" IsChecked="{Binding OptilandInstall}" Margin="0,6,0,0"/>
                    <TextBlock Classes="label" Text="OpticStudio Glasscat folder (names only, read-only)" Margin="0,6,0,2"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding ZemaxGlasscat}" Watermark="Documents\Zemax\Glasscat"/>
                        <Button Grid.Column="1" Content="..." Margin="4,0,0,0" Click="BrowseGlasscatClick"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Results -->
            <DockPanel Grid.Column="1" Margin="10,8,10,8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
                    <Button Content="Run" Command="{Binding RunCommand}" FontWeight="SemiBold" Width="90"
                            HorizontalContentAlignment="Center"/>
                    <Button Content="Stop" Command="{Binding CancelCommand}" Width="90" HorizontalContentAlignment="Center"
                            ToolTip.Tip="Stop the search and keep what it has found: the combinations screened so far are refined and ranked (a few seconds), and the table shows them."/>
                    <Button Content="Export Top N" Click="ExportTopClick" IsEnabled="{Binding CanExport}"/>
                    <Button Content="Export Selected" Click="ExportSelectedClick" IsEnabled="{Binding CanExport}"/>
                    <Button Content="Save Table as CSV..." Click="SaveTableClick" IsEnabled="{Binding CanExport}"
                            ToolTip.Tip="Every ranked design in the table, in rank order, as a CSV file (opens in Excel)."/>
                    <Button Content="Open Output Folder" Click="OpenFolderClick"/>
                    <Button Content="Use Cores for 4GA-8" Click="UseCoresClick" IsEnabled="{Binding CanUseCores}"
                            IsVisible="{Binding !Shows4GA8}"
                            ToolTip.Tip="Set up a 4GA-8 search with the ball glasses of the selected 2GS designs as the core."/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding SummaryText}" Margin="0,8,0,6" FontSize="12"
                           TextWrapping="Wrap" Foreground="#444444"/>
                <Grid RowDefinitions="*,5,1.2*">
                <DataGrid x:Name="Results4Grid" ItemsSource="{Binding Results4}" SelectedItem="{Binding SelectedResult4}"
                          AutoGenerateColumns="False" IsVisible="{Binding Shows4GA8}"
                          IsReadOnly="True" SelectionMode="Extended" CanUserSortColumns="True" CanUserResizeColumns="True"
                          GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#CCCCCC">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="50"/>
                        <DataGridTextColumn Header="Fam" Binding="{Binding Family}" Width="50"/>
                        <DataGridTextColumn Header="Front shell" Binding="{Binding Front}" Width="*"/>
                        <DataGridTextColumn Header="Core" Binding="{Binding Core}" Width="*"/>
                        <DataGridTextColumn Header="Rear shell" Binding="{Binding Rear}" Width="*"/>
                        <DataGridTextColumn Header="Meniscus" Binding="{Binding Meniscus}" Width="*"/>
                        <DataGridTextColumn Header="R1" Binding="{Binding R1, StringFormat=\{0:F3\}}" Width="62"/>
                        <DataGridTextColumn Header="R2" Binding="{Binding R2, StringFormat=\{0:F3\}}" Width="62"/>
                        <DataGridTextColumn Header="R4" Binding="{Binding R4, StringFormat=\{0:F3\}}" Width="62"/>
                        <DataGridTextColumn Header="R5" Binding="{Binding R5, StringFormat=\{0:F3\}}" Width="62"/>
                        <DataGridTextColumn Header="R6" Binding="{Binding R6, StringFormat=\{0:F3\}}" Width="62"/>
                        <DataGridTextColumn Header="BFL" Binding="{Binding BackFocus, StringFormat=\{0:F2\}}" Width="58"/>
                        <DataGridTextColumn Header="C" Binding="{Binding C, StringFormat=\{0:F5\}}" Width="75"/>
                        <DataGridTextColumn Header="RMS (waves)" Binding="{Binding Rms, StringFormat=\{0:F4\}}" Width="95"/>
                        <DataGridTextColumn Header="dCTE" Binding="{Binding DeltaCte, StringFormat=\{0:F1\}}" Width="58"/>
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" AutoGenerateColumns="False"
                          IsVisible="{Binding !Shows4GA8}"
                          IsReadOnly="True" SelectionMode="Extended" CanUserSortColumns="True" CanUserResizeColumns="True"
                          GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#CCCCCC">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="55"/>
                        <DataGridTextColumn Header="Outer shell" Binding="{Binding Outer}" Width="2*"/>
                        <DataGridTextColumn Header="nd" Binding="{Binding OuterNd, StringFormat=\{0:F4\}}" Width="70"/>
                        <DataGridTextColumn Header="Vd" Binding="{Binding OuterVd, StringFormat=\{0:F1\}}" Width="55"/>
                        <DataGridTextColumn Header="Inner ball" Binding="{Binding Inner}" Width="2*"/>
                        <DataGridTextColumn Header="nd" Binding="{Binding InnerNd, StringFormat=\{0:F4\}}" Width="70"/>
                        <DataGridTextColumn Header="Vd" Binding="{Binding InnerVd, StringFormat=\{0:F1\}}" Width="55"/>
                        <DataGridTextColumn Header="r1" Binding="{Binding R1, StringFormat=\{0:F3\}}" Width="70"/>
                        <DataGridTextColumn Header="r2" Binding="{Binding R2, StringFormat=\{0:F3\}}" Width="70"/>
                        <DataGridTextColumn Header="BFL" Binding="{Binding BackFocus, StringFormat=\{0:F3\}}" Width="70"/>
                        <DataGridTextColumn Header="Image R" Binding="{Binding ImageRadius, StringFormat=\{0:F3\}}" Width="80"/>
                        <DataGridTextColumn Header="(dPhi)^2" Binding="{Binding DPhi2, StringFormat=\{0:F5\}}" Width="85"/>
                        <DataGridTextColumn Header="RMS (waves)" Binding="{Binding Rms, StringFormat=\{0:F4\}}" Width="100"/>
                        <DataGridTextColumn Header="dCTE" Binding="{Binding DeltaCte, StringFormat=\{0:F1\}}" Width="65"/>
                    </DataGrid.Columns>
                </DataGrid>
                <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="#DDDDDD"/>
                <Border Grid.Row="2" BorderThickness="1" BorderBrush="#CCCCCC">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding SelectedText}" FontSize="12" Margin="8,4"
                                   TextWrapping="Wrap" Foreground="#444444"/>
                        <views:LensView Layout="{Binding SelectedLayout}" ClipToBounds="True"/>
                    </DockPanel>
                </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
